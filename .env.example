# =====================================================================
# NNGG Euskadi · Variables de entorno
# Copia este archivo a .env.local y rellena los valores. NUNCA subas .env.local a GitHub.
# Las variables NEXT_PUBLIC_* son visibles en el navegador: nunca pongas secretos en ellas.
# =====================================================================

# --- Modo de la aplicación -------------------------------------------
# demo: sin servicios externos, usuarios ficticios y datos de ejemplo (por defecto).
# live: autenticación y datos personales en Supabase, contenido desde Google Sheets.
NEXT_PUBLIC_APP_MODE=demo

# URL pública de la app (enlaces de recuperación de acceso / invitación).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Origen del contenido organizativo ---------------------------------
# sheets (por defecto en live) | demo. En modo demo solo se permite "sheets" fuera de producción.
CONTENT_SOURCE=

# --- Supabase (Project Settings → API) -------------------------------
NEXT_PUBLIC_SUPABASE_URL=
# Clave pública "anon" / "publishable". Es pública por diseño; la seguridad la da RLS.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SECRETO. Clave "service_role" / "secret". Solo servidor: inscripciones con control de aforo,
# agregados y script de alta de afiliados. Nunca con prefijo NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# --- Google Sheets (cuenta de servicio con acceso de LECTURA al Sheet) ---
# ID del Sheet: lo que va entre /d/ y /edit en la URL.
GOOGLE_SHEETS_SPREADSHEET_ID=
GOOGLE_SERVICE_ACCOUNT_EMAIL=
# SECRETO. Clave privada de la cuenta de servicio (campo private_key del JSON), entre comillas,
# con los saltos de línea como \n.
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=
# Segundos que se cachea el Sheet antes de volver a leerlo (por defecto 60).
SHEETS_REVALIDATE_SECONDS=60

# --- Endpoints internos ------------------------------------------------
# SECRETO (mínimo 24 caracteres). Protege /api/agregados (cifras para el Sheet) y /api/revalidar.
# Genera uno con: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# Vacío = endpoints desactivados.
INTERNAL_API_TOKEN=
